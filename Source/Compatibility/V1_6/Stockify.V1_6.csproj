<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Stockify</AssemblyName>
    <RootNamespace>Stockify</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\..</RimWorldDir>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\..\1.6\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RimWorld">
      <HintPath>$(RimWorldDir)\RimWorld.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="RimWorld" />
    <Using Include="UnityEngine" />
    <Using Include="Verse" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../Shared/StockifyMod.cs" />
    <Compile Include="../../Shared/StockifySettings.cs" />
    <Compile Include="../../Shared/StockifyStorageManager.cs" />
    <Compile Include="../../Shared/StockifyNetwork.cs" />
    <Compile Include="../../Shared/StockifyMapComponent.cs" />
    <Compile Include="../../Shared/StockifyMainWindow.cs" />
    <Compile Include="../../Shared/StockifyNetworkFilterWindow.cs" />
    <Compile Include="../../Shared/StockifyNetworkShelvesWindow.cs" />
    <Compile Include="../../Shared/StockifyMainButtonWorker.cs" />
    <Compile Include="../../Shared/StockifyDesignationTool.cs" />
    <Compile Include="../../Shared/StockifyShelf.cs" />
    <Compile Include="../../Shared/CompProperties_StockifyShelf.cs" />
    <Compile Include="../../Shared/CompStockifyShelf.cs" />
    <Compile Include="../../Shared/StockifyWorkGiver.cs" />
    <Compile Include="../../Shared/StockifyInventoryManager.cs" />
    <Compile Include="../../Shared/StockifyGetWindow.cs" />
    <Compile Include="../../Shared/StockifyMaterialSearch.cs" />
    <Compile Include="../../Shared/StockifySelectionMode.cs" />
    <Compile Include="../../Shared/NetworkMaterialInfo.cs" />
  </ItemGroup>

</Project>